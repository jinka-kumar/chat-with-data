# Optional settings. To use them:  cp .env.example .env   then edit .env
# No API keys or secrets are needed: everything runs locally with Ollama.
# setup.sh and run.sh load .env automatically.

# Chat model. Smaller = faster. Try llama3.2:1b on older / Intel Macs.
CHAT_MODEL=llama3.2

# Model that writes SQL for spreadsheet questions. A code model is more accurate,
# e.g. qwen2.5-coder:7b (run: ollama pull qwen2.5-coder:7b). Default: same as CHAT_MODEL.
SQL_MODEL=qwen2.5-coder:14b

# Embedding model. If you change this, delete the data folder (DB_PATH) and
# re-upload your PDFs: vectors from different models can't be compared.
EMBED_MODEL=nomic-embed-text

# Where indexed documents and spreadsheet tables are stored on disk.
DB_PATH=./chroma_db

# Set to 0 to compare vector-only search with hybrid (vectors + keywords).
HYBRID=1
